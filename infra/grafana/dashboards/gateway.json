{
  "uid": "evcharge-gateway",
  "title": "evcharge station gateway",
  "description": "Station gateway: WebSocket upgrades, credentials, produce path, commands, safe-share, runtime health.",
  "tags": [
    "evcharge"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
