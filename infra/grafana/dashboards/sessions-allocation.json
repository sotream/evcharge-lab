      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (strategy, reason) (rate(sessions_allocation_rounds_total[$__rate_interval]))",
          "legendFormat": "{{strategy}} / {{reason}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
