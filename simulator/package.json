{
  "name": "@evcharge/simulator",
  "version": "0.1.0",
  "private": true,
  "description": "OCPP 1.6J station fleet simulator: physics, profiles, offline replay, storms, floods, probes, driver traffic (ADR 0013).",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --enable-source-maps dist/main.js",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project int"
  },
  "dependencies": {
    "@evcharge/contracts": "workspace:*",
    "@evcharge/platform": "workspace:*",
    "prom-client": "^15.1.3",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@evcharge/station-gateway": "workspace:*",
    "@platformatic/kafka": "^2.15.0",
    "@types/node": "^26.0.0",
    "@types/ws": "^8.18.2",
    "ioredis": "^6.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
