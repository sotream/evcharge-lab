    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.4.0",
    "@platformatic/kafka": "^2.15.0",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.23.1",
