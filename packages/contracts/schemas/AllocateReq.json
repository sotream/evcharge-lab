{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "siteId": {
      "type": "string"
    },
    "siteCapW": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "idleConnectors": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "startW": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "stationId": {
            "type": "string"
          },
          "connectorId": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "maxW": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "minW": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "measuredW": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "priority": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "sessionId",
          "stationId",
          "connectorId",
          "maxW",
          "minW",
          "startedAt"
        ]
      }
    }
  },
  "required": [
    "siteId",
    "siteCapW",
    "idleConnectors",
    "startW",
    "sessions"
  ]
}
