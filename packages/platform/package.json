{
  "name": "@evcharge/platform",
  "version": "0.1.0",
  "private": true,
  "description": "Shared production plumbing for evcharge Node services: config, logging, telemetry, metrics, health, lifecycle, HTTP client, auth, Postgres, outbox/inbox, idempotency, Kafka, Redis.",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./telemetry": { "types": "./dist/telemetry/index.d.ts", "default": "./dist/telemetry/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project int"
  },
  "dependencies": {
    "@evcharge/contracts": "workspace:*",
    "@fastify/otel": "^1.0.1",
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-fastify": "^12.4.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/core": "^3.1.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.0",
    "@opentelemetry/instrumentation": "^0.301.0",
    "@opentelemetry/instrumentation-http": "^0.301.0",
    "@opentelemetry/instrumentation-ioredis": "^0.73.0",
    "@opentelemetry/instrumentation-pg": "^0.78.0",
    "@opentelemetry/instrumentation-undici": "^0.35.0",
    "@opentelemetry/resources": "^3.1.0",
    "@opentelemetry/sdk-node": "^0.301.0",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@platformatic/kafka": "^2.15.0",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.4.0",
    "@opentelemetry/context-async-hooks": "^3.1.0",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
