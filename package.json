{
  "name": "evcharge-lab",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=4 run build",
    "lint": "oxlint --deny-warnings",
    "typecheck": "pnpm -r run typecheck",
    "test:unit": "pnpm -r run test:unit",
    "test:int": "pnpm -r --workspace-concurrency=1 run test:int"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "oxlint": "^1.92.0"
  }
}
